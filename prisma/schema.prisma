generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Student {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  attempts  ExamAttempt[]
}

model ExamAttempt {
  id             String   @id @default(cuid())

  studentId      String
  student        Student  @relation(fields: [studentId], references: [id])

  score          Float
  correct        Int
  incorrect      Int
  totalQuestions Int

  answers        Json

  createdAt      DateTime @default(now())
}